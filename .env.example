# CertGate configuration. Copy to .env and fill in; .env is never committed. Every variable has no value here.
# Reading mode for the CLI and dataset API: mock (default; offline, dataset readings) or real (no adapter: fails visibly).
CERTGATE_MODE=
# HTTP port of the local service (default 3000).
PORT=
# Dataset directory (default: <repo>/data).
CERTGATE_DATA_DIR=
# Live model endpoint (OpenAI-compatible, e.g. vLLM). No default: unset means "endpoint off".
MODEL_BASE_URL=
# Secret. Sent only to MODEL_BASE_URL by the server; never to the browser.
MODEL_API_KEY=
MODEL_ID=
# Sidecar next to vLLM that reports GPU and ROCm versions (JSON: gpu, rocm_version, vllm_version).
GPU_INFO_URL=
# GPU price in USD per hour for the F1 cost estimate. Unset: cost "unknown".
GPU_COST_PER_HOUR=
# Live readings per UTC hour, counted on the server (per server instance in this build). Unset or 0: live reading disabled.
LIVE_READS_PER_HOUR=
# Secret, optional. If set, live reading requires this code; checked on the server only.
LIVE_ACCESS_CODE=
# Wrong access-code attempts allowed per UTC hour before rejection (default 5).
LIVE_CODE_FAILURES_PER_HOUR=
# Announced live windows, free text shown on the landing page (e.g. "Oct 16, 18:00-20:00 UTC").
LIVE_WINDOWS=