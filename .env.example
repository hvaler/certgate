# CertGate configuration. Copy to .env and fill in; .env is never committed. Every variable has no value here.
# Reading mode for the CLI and dataset API: mock (default; offline, dataset readings) or real (no adapter: fails visibly).
CERTGATE_MODE=
# HTTP port of the local service (default 3000).
PORT=
# Dataset directory (default: <repo>/data).
CERTGATE_DATA_DIR=
# Live model endpoint: AMD Token Factory (OpenAI-compatible). No default: unset means "endpoint off".
# Never write its value in the repository, logs or evidence; the host name may appear.
MODEL_BASE_URL=
# Secret. Sent only to MODEL_BASE_URL by the server; never to the browser, the repository, logs or evidence.
MODEL_API_KEY=
# Model id requested from the endpoint; changes only if the human changes it.
MODEL_ID=
# Live readings per UTC hour, counted on the server, per server instance in this build. Unset or 0: live reading
# disabled. Documented deployment value: 20 (S3-20).
LIVE_READS_PER_HOUR=
# Secret, optional. Live reading of a visitor-uploaded file is possible only when this is set and the code is given;
# without it, live reading is limited to the dataset certificates (matched by SHA-256) (R3.1 C-02).
LIVE_ACCESS_CODE=
# Wrong access-code attempts allowed per UTC hour before rejection (default 5).
LIVE_CODE_FAILURES_PER_HOUR=
# Announced live windows, free text shown on the landing page (e.g. "Oct 16, 18:00-20:00 UTC").
LIVE_WINDOWS=
# Set automatically by Vercel (VERCEL=1); do not set it yourself. On the deployed site live reading is unavailable:
# the live path (300 s per attempt, up to 3 attempts) does not fit the 300 s function duration (S3-24, C-07).
VERCEL=
