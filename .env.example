# CertGate configuration. Copy to .env and fill in; .env is never committed. Every variable has no value here.
# Reading mode for the CLI and dataset API: mock (default; offline, dataset readings) or real (no adapter: fails visibly).
CERTGATE_MODE=
# HTTP port of the local service (default 3000).
PORT=
# Dataset directory (default: <repo>/data).
CERTGATE_DATA_DIR=
# Live model endpoint: AMD Token Factory (OpenAI-compatible). No default: unset means "endpoint off".
# Never write its value in the repository, logs or evidence; the host name may appear.
MODEL_BASE_URL=
# Secret. Sent only to MODEL_BASE_URL by the server; never to the browser, the repository, logs or evidence.
MODEL_API_KEY=
# Model id requested from the endpoint; changes only if the human changes it.
MODEL_ID=
# Live readings per UTC hour. On the deployed site the limit is global: counted in the shared store across all
# instances. In the container it is counted per server process, in the in-process store. Unset or 0: live reading
# disabled. Documented deployment value: 20 (S3-20).
LIVE_READS_PER_HOUR=
# Secret. On the deployed site it is mandatory: without it live reading stays off there (S6-01). In the container it
# is optional: when it is set and the code is given, a visitor-uploaded file can be read live; without it, live
# reading is limited to the dataset certificates (matched by SHA-256) (R3.1 C-02).
LIVE_ACCESS_CODE=
# Wrong access-code attempts allowed per UTC hour and per client before rejection (default 5). Wrong codes from all
# clients are also counted together for monitoring only; that count never refuses a correct code.
LIVE_CODE_FAILURES_PER_HOUR=
# Announced live windows, free text shown on the landing page (e.g. "Oct 16, 18:00-20:00 UTC").
LIVE_WINDOWS=
# Set automatically by Vercel (VERCEL=1); do not set it yourself. On the deployed site live reading runs as a job
# within the 300 s function duration, and only with LIVE_ACCESS_CODE, the shared store and LIVE_READS_PER_HOUR set.
VERCEL=
# Shared store for live reading on the deployed site (Stage 6): set by the Upstash Redis integration of the Vercel
# Marketplace, never by hand. Either pair is read (Upstash names first); the token is a secret. Not used in the
# container, which keeps its queue and limits in process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
